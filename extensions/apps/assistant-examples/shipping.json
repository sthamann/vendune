    "customers.pii",
    "deliveries.write",
    "documents.create",
    "jobs.write",
    "events:self"
  ],
  "entities": [
    {
      "name": "entries",
      "label": {
        "en": "Extension example",
        "de": "Erweiterungsbeispiel",
        "fr": "Exemple d’extension",
        "es": "Ejemplo de extensión"
      },
      "publicRead": false,
      "fields": [
        {
          "name": "title",
          "label": {
            "en": "Title",
            "de": "Titel",
            "fr": "Titre",
            "es": "Título"
          },
          "kind": "string",
          "translatable": true,
          "required": true
        },
        {
          "name": "body",
          "label": {
            "en": "Content",
            "de": "Inhalt",
            "fr": "Contenu",
            "es": "Contenido"
          },
          "kind": "string",
          "translatable": true
        },
        {
          "name": "segment",
          "label": {
            "en": "Selection",
            "de": "Auswahlliste",
            "fr": "Liste de choix",
            "es": "Lista de selección"
          },
          "kind": "string",
          "choices": [
            {
              "value": "standard",
              "label": {
                "en": "Standard",
                "de": "Standard",
                "fr": "Standard",
                "es": "Estándar"
              }
            },
            {
              "value": "priority",
              "label": {
                "en": "Priority",
                "de": "Priorität",
                "fr": "Priorité",
                "es": "Prioridad"
              }
            }
          ]
        }
      ]
    }
  ],
  "slots": [],
  "views": [
    {
      "id": "workspace",
      "layout": "stack",
      "blocks": [
        {
          "id": "records",
          "kind": "table",
          "title": {
            "en": "Content",
            "de": "Inhalt",
            "fr": "Contenu",
            "es": "Contenido"
          },
          "entity": "entries",
          "readAction": "list_entries",
          "writeAction": null
        },
        {
          "id": "editor",
          "kind": "form",
          "title": {
            "en": "Shape your app",
            "de": "Deine App gestalten",
            "fr": "Configurez votre app",
            "es": "Configura tu app"
          },
          "entity": "entries",
          "readAction": "list_entries",
          "writeAction": "save_entries"
        }
      ]
    }
  ],
  "surfaces": [
    {
      "id": "workspace",
      "location": "admin.navigation",
      "label": {
        "en": "Extension example",
        "de": "Erweiterungsbeispiel",
        "fr": "Exemple d’extension",
        "es": "Ejemplo de extensión"
      },
      "uiPath": "native/workspace",
      "actions": [
        "list_entries",
        "save_entries"
      ],
      "permission": "catalog.read"
    }
  ],
  "apiRoutes": [
    {
      "path": "list_entries",
      "method": "GET",
      "scope": "admin",
      "action": "list_entries"
    },
    {
      "path": "create_label",
      "action": "create_label",
      "method": "POST",
      "scope": "admin"
    }
  ],
  "intelligence": {
    "description": {
      "en": "Extension example",
      "de": "Erweiterungsbeispiel",
      "fr": "Exemple d’extension",
      "es": "Ejemplo de extensión"
    },
    "tools": [],
    "entities": []
  },
  "events": [
    "app.example_shipping.job_create_label"
  ],
  "actions": [
    {
      "name": "list_entries",
      "description": "List entries",
      "handler": "list",
      "entity": "entries",
      "public": false,
      "readOnly": true,
      "mcp": false,
      "permission": "catalog.read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer"
          },
          "after": {
            "type": "string"
          },
          "filter": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "save_entries",
      "description": "Save entries",
      "handler": "save",
      "entity": "entries",
      "public": false,
      "flowAllowed": true,
      "permission": "catalog.write",
      "mcp": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "fields": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "fields"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "create_label",
      "description": "Create a carrier label through a fenced native job",
      "handler": "job",
      "public": false,
      "permission": "orders.write",
      "requiredPermissions": [
        "customers.pii",
        "documents.create"
      ],
      "mcp": false,
      "flowAllowed": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "maxLength": 100
          },
          "deliveryIndex": {
            "type": "integer",
            "minimum": 0
          },
          "account": {
            "type": "string",
            "maxLength": 64
          },
          "weightGrams": {
            "type": "integer",
            "minimum": 1
          },
          "lengthMm": {
            "type": "integer",
            "minimum": 1
          },
          "widthMm": {
            "type": "integer",
            "minimum": 1
          },
          "heightMm": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "orderId",
          "deliveryIndex",
          "account",
          "weightGrams",
          "lengthMm",
          "widthMm",
          "heightMm"
        ],
        "additionalProperties": false
      }
    }
  ]
}
