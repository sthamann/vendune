{
  "id": "erp_handoff",
  "version": "0.2.0",
  "coreApi": "1",
  "runtime": "service",
  "name": {
    "en": "ERP handoff",
    "de": "ERP-Anbindung",
    "fr": "Connexion ERP",
    "es": "Conexión ERP"
  },
  "category": "operations",
  "permissions": [
    "data.read",
    "data.write",
    "admin.slot",
    "service.call",
    "orders.read",
    "events:order.placed"
  ],
  "entities": [
    {
      "name": "entries",
      "label": {
        "en": "ERP handoff",
        "de": "ERP-Anbindung",
        "fr": "Connexion ERP",
        "es": "Conexión ERP"
      },
      "publicRead": false,
      "fields": [
        {
          "name": "order_id",
          "kind": "string",
          "indexed": true,
          "coreReference": "order",
          "label": {
            "en": "Order to export",
            "de": "Zu übertragende Bestellung",
            "fr": "Commande à exporter",
            "es": "Pedido a exportar"
          },
          "required": true
        },
        {
          "name": "title",
          "label": {
            "en": "Title",
            "de": "Titel",
            "fr": "Titre",
            "es": "Título"
          },
          "kind": "string",
          "translatable": true,
          "required": true
        },
        {
          "name": "body",
          "label": {
            "en": "Reason / advice",
            "de": "Grund / Empfehlung",
            "fr": "Motif / conseil",
            "es": "Motivo / consejo"
          },
          "kind": "string",
          "translatable": true
        }
      ]
    }
  ],
  "slots": [],
  "views": [
    {
      "id": "workspace",
      "layout": "form",
      "blocks": [
        {
          "id": "records",
          "kind": "table",
          "title": {
            "en": "ERP handoff",
            "de": "ERP-Anbindung",
            "fr": "Connexion ERP",
            "es": "Conexión ERP"
          },
          "entity": "entries",
          "readAction": "list_entries",
          "geometry": {
            "x": 0,
            "y": 0,
            "w": 6,
            "h": 10
          }
        },
        {
          "id": "editor",
          "kind": "form",
          "title": {
            "en": "Record",
            "de": "Datensatz",
            "fr": "Enregistrement",
            "es": "Registro"
          },
          "entity": "entries",
          "readAction": "list_entries",
          "writeAction": "save_entries",
          "geometry": {
            "x": 6,
            "y": 0,
            "w": 6,
            "h": 10
          }
        },
        {
          "id": "save",
          "kind": "button",
          "title": {
            "en": "Save record",
            "de": "Datensatz speichern",
            "fr": "Enregistrer",
            "es": "Guardar registro"
          },
          "geometry": {
            "x": 6,
            "y": 10,
            "w": 6,
            "h": 2
          },
          "handlers": {
            "click": [
              {
                "op": "validate",
                "target": "editor"
              },
              {
                "op": "call",
                "action": "save_entries",
                "input": {
                  "kind": "record",
                  "block": "editor"
                }
              },
              {
                "op": "refresh",
                "target": "records"
              }
            ]
          }
        },
        {
          "id": "export",
          "kind": "button",
          "title": {
            "en": "Export this order",
            "de": "Bestellung übertragen",
            "fr": "Exporter cette commande",
            "es": "Exportar este pedido"
          },
          "geometry": {
            "x": 0,
            "y": 12,
            "w": 12,
            "h": 2
          },
          "handlers": {
            "click": [
              {
                "op": "validate",
                "target": "editor"
              },
              {
                "op": "call",
                "action": "synchronize",
                "input": {
                  "kind": "object",
                  "fields": {
                    "payload": {
                      "kind": "object",
                      "fields": {
                        "orderId": {
                          "kind": "value",
                          "block": "editor",
                          "field": "order_id"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "surfaces": [
    {
      "id": "workspace",
      "location": "admin.navigation",
      "label": {
        "en": "ERP handoff",
        "de": "ERP-Anbindung",
        "fr": "Connexion ERP",
        "es": "Conexión ERP"
      },
      "uiPath": "native/workspace",
      "actions": [
        "list_entries",
        "save_entries",
        "synchronize"
      ],
      "permission": "orders.read"
    }
  ],
  "apiRoutes": [
    {
      "path": "list_entries",
      "method": "GET",
      "scope": "admin",
      "action": "list_entries"
    },
    {
      "path": "receipts",
      "method": "GET",
      "scope": "admin",
      "action": "receipts"
    },
    {
      "path": "reconcile",
      "method": "POST",
      "scope": "admin",
      "action": "reconcile"
    }
  ],
  "intelligence": {
    "description": {
      "en": "ERP handoff",
      "de": "ERP-Anbindung",
      "fr": "Connexion ERP",
      "es": "Conexión ERP"
    },
    "tools": [],
    "entities": []
  },
  "events": [
    "order.placed"
  ],
  "actions": [
    {
      "name": "synchronize",
      "description": "synchronize",
      "handler": "service",
      "public": false,
      "permission": "orders.write",
      "mcp": false,
      "flowAllowed": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "orderId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "orderId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "payload"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_entries",
      "description": "List entries",
      "handler": "list",
      "entity": "entries",
      "public": false,
      "readOnly": true,
      "mcp": false,
      "permission": "orders.read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer"
          },
          "after": {
            "type": "string"
          },
          "filter": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "save_entries",
      "description": "Save entries",
      "handler": "save",
      "entity": "entries",
      "public": false,
      "flowAllowed": true,
      "permission": "orders.write",
      "mcp": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "fields": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "fields"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "receipts",
      "description": "Read app-owned ERP receipts",
      "handler": "service",
      "public": false,
      "readOnly": true,
      "permission": "orders.read",
      "mcp": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "reconcile",
      "description": "Confirm an uncertain ERP receipt without exporting again",
      "handler": "service",
      "public": false,
      "permission": "orders.write",
      "mcp": false,
      "flowAllowed": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "orderId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "orderId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "payload"
        ],
        "additionalProperties": false
      }
    }
  ],
  "presentation": {
    "description": {
      "en": "Event-driven connector contract. The external ERP service must be deployed separately.",
      "de": "Ereignisbasierter Anschlussvertrag. Der externe ERP-Dienst muss separat bereitgestellt werden.",
      "fr": "Contrat événementiel. Le service ERP externe doit être déployé séparément.",
      "es": "Contrato basado en eventos. El servicio ERP externo requiere despliegue separado."
    }
  },
  "eventDelivery": {
    "batchSize": 1
  }
}
