      "name": "sync",
      "handler": "job",
      "description": "Sync",
      "permission": "apps.manage",
      "readOnly": false,
      "mcp": true,
      "flowAllowed": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "connectionId": {
            "type": "string",
            "maxLength": 100
          },
          "kind": {
            "type": "string",
            "enum": [
              "listing",
              "orders"
            ]
          },
          "listingId": {
            "type": "string",
            "maxLength": 100
          },
          "after": {
            "type": "string",
            "maxLength": 2000
          },
          "cursor": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "connectionId",
          "kind"
        ],
        "additionalProperties": false
      },
      "requiredPermissions": [
        "customers.pii"
      ]
    },
    {
      "name": "import_order",
      "handler": "service",
      "description": "Import order",
      "permission": "orders.write",
      "readOnly": false,
      "mcp": true,
      "flowAllowed": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "inboxId": {
            "type": "string",
            "maxLength": 100
          },
          "approve": {
            "type": "boolean"
          },
          "snapshot": {
            "type": "object"
          }
        },
        "required": [
          "inboxId",
          "approve",
          "snapshot"
        ],
        "additionalProperties": false
      },
      "requiredPermissions": [
        "payments.manage",
        "customers.pii"
      ]
    },
    {
      "name": "review_order",
