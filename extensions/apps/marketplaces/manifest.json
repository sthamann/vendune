      "entity": "connections",
      "permission": "apps.manage",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "after": {
            "type": "string",
            "maxLength": 100
          },
          "filter": {
            "type": "object"
          },
          "id": {
            "type": "string",
            "maxLength": 100
          }
        },
        "additionalProperties": false
