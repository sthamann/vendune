    {
      "name": "prepare",
      "handler": "service",
      "description": "Prepare",
      "permission": "apps.manage",
      "readOnly": false,
      "mcp": true,
      "flowAllowed": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "listingId": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "listingId"
        ],
        "additionalProperties": false
      }
    },
