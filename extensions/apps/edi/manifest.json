  "slots": [],
  "views": [
    {
      "id": "workspace",
      "layout": "stack",
      "blocks": [
        {
          "id": "intro",
          "kind": "text",
          "title": {
            "en": "EDI workspace",
            "de": "EDI-Arbeitsbereich",
            "fr": "Espace EDI",
            "es": "Espacio EDI"
          },
          "text": {
            "en": "Map partners to existing purchasing units and buyers. Import creates a private order list; the buyer still checks native prices and obtains required approval.",
            "de": "Ordne Partner vorhandenen Einkaufseinheiten und K\u00e4ufern zu. Der Import erstellt eine private Bestellliste; Preise und Freigaben werden beim Einkauf gepr\u00fcft.",
            "fr": "Associez les partenaires aux unit\u00e9s et acheteurs. L\u2019import cr\u00e9e une liste priv\u00e9e ; prix natifs et approbations restent obligatoires.",
            "es": "Asocia socios con unidades y compradores. La importaci\u00f3n crea una lista privada; se mantienen precios y aprobaciones nativos."
          }
        },
        {
          "id": "partners",
          "kind": "table",
          "title": {
            "en": "Partners",
            "de": "Partner",
            "fr": "Partenaires",
            "es": "Socios"
          },
          "entity": "partners",
          "readAction": "list_partners"
        },
        {
          "id": "partners_editor",
          "kind": "form",
          "title": {
            "en": "Partners",
            "de": "Partner",
            "fr": "Partenaires",
            "es": "Socios"
          },
          "entity": "partners",
          "readAction": "list_partners",
          "writeAction": "save_partners"
        },
        {
          "id": "messages",
          "kind": "table",
          "title": {
            "en": "Imported documents",
            "de": "Importierte Dokumente",
            "fr": "Documents import\u00e9s",
            "es": "Documentos importados"
          },
          "entity": "messages",
          "readAction": "list_messages"
        },
        {
          "id": "inputs",
          "kind": "table",
          "title": {
            "en": "Import document",
            "de": "Dokument importieren",
            "fr": "Importer un document",
            "es": "Importar documento"
          },
          "entity": "inputs",
          "readAction": "list_inputs"
        },
        {
          "id": "inputs_editor",
          "kind": "form",
          "title": {
            "en": "Import document",
            "de": "Dokument importieren",
            "fr": "Importer un document",
            "es": "Importar documento"
          },
          "entity": "inputs",
          "readAction": "list_inputs",
          "writeAction": "save_inputs"
        },
        {
          "id": "validate_document",
          "kind": "button",
          "title": {
            "en": "Check document",
            "de": "Dokument pr\u00fcfen",
            "fr": "V\u00e9rifier document",
            "es": "Comprobar documento"
          },
          "handlers": {
            "click": [
              {
                "op": "validate",
                "target": "inputs_editor"
              },
              {
                "op": "call",
                "action": "validate_document",
                "input": {
                  "kind": "object",
                  "fields": {
                    "partnerId": {
                      "kind": "value",
                      "block": "inputs_editor",
                      "field": "partner_id"
                    },
                    "format": {
                      "kind": "value",
                      "block": "inputs_editor",
                      "field": "format"
                    },
                    "document": {
                      "kind": "value",
                      "block": "inputs_editor",
                      "field": "document"
                    }
                  }
                }
              },
              {
                "op": "refresh",
                "target": "messages"
              }
            ]
          }
        },
        {
          "id": "import_document",
          "kind": "button",
          "title": {
            "en": "Import requisition",
            "de": "Bestellliste importieren",
            "fr": "Importer la liste",
            "es": "Importar lista"
          },
          "handlers": {
            "click": [
              {
                "op": "validate",
                "target": "inputs_editor"
              },
              {
                "op": "call",
                "action": "import_document",
                "input": {
                  "kind": "object",
                  "fields": {
                    "partnerId": {
                      "kind": "value",
                      "block": "inputs_editor",
                      "field": "partner_id"
                    },
                    "format": {
                      "kind": "value",
                      "block": "inputs_editor",
                      "field": "format"
                    },
                    "document": {
                      "kind": "value",
                      "block": "inputs_editor",
                      "field": "document"
                    }
                  }
                }
              },
              {
                "op": "refresh",
                "target": "messages"
              }
            ]
          }
        }
      ]
    }
