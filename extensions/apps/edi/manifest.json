  "surfaces": [
    {
      "id": "workspace",
      "location": "admin.navigation",
      "label": {
        "en": "EDI workspace",
        "de": "EDI-Arbeitsbereich",
        "fr": "Espace EDI",
        "es": "Espacio EDI"
      },
      "uiPath": "native/workspace",
      "permission": "b2b.read",
      "actions": [
        "list_partners",
        "save_partners",
        "list_messages",
        "save_messages",
        "list_inputs",
        "save_inputs",
        "validate_document",
        "import_document"
      ]
    }
