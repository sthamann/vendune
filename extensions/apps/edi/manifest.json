    {
      "name": "validate_document",
      "description": "Validate partner document",
      "handler": "service",
      "public": false,
      "readOnly": true,
      "permission": "b2b.read",
      "mcp": true,
      "flowAllowed": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "partnerId": {
            "type": "string",
            "maxLength": 100
          },
          "format": {
            "type": "string",
            "enum": [
              "edifact",
              "ubl",
              "cxml"
            ]
          },
          "document": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000
          }
        },
        "required": [
          "partnerId",
          "format",
          "document"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "import_document",
      "description": "Import partner order as a native requisition",
      "handler": "service",
      "public": false,
      "readOnly": false,
      "permission": "b2b.manage",
      "mcp": true,
      "flowAllowed": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "partnerId": {
            "type": "string",
            "maxLength": 100
          },
          "format": {
            "type": "string",
            "enum": [
              "edifact",
              "ubl",
              "cxml"
            ]
          },
          "document": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000
          }
        },
        "required": [
          "partnerId",
          "format",
          "document"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "export_document",
      "description": "Serialize a mapped native order or issued document",
      "handler": "service",
      "public": false,
      "readOnly": true,
      "permission": "b2b.manage",
      "mcp": true,
      "flowAllowed": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "partnerId": {
            "type": "string",
            "maxLength": 100
          },
          "format": {
            "type": "string",
            "enum": [
              "edifact",
              "ubl"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "order_response",
              "delivery_note",
              "invoice"
            ]
          },
          "orderId": {
            "type": "string",
            "maxLength": 100
          },
          "receiptId": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "partnerId",
          "format",
          "kind",
          "orderId"
        ],
        "additionalProperties": false
      }
    }
