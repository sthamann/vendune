      "description": "Read private partners",
      "handler": "list",
      "entity": "partners",
      "public": false,
      "readOnly": true,
      "permission": "b2b.read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer"
          },
          "filter": {
            "type": "object"
          },
          "after": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "save_partners",
