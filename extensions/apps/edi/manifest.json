      "handler": "save",
      "entity": "partners",
      "public": false,
      "permission": "b2b.manage",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "fields": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "revision",
          "fields"
        ],
        "additionalProperties": false
      }
    },
