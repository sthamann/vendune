            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "save_inputs",
      "description": "Revise private inputs",
      "handler": "save",
      "entity": "inputs",
      "public": false,
      "permission": "b2b.manage",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "fields": {
            "type": "object"
          }
        },
